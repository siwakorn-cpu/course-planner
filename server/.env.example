# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (สำหรับรันในเครื่อง)
# บน Render ให้ตั้งค่าเหล่านี้ในหน้า Environment ของ service แทน

# connection string ของ Aiven for PostgreSQL (ขึ้นต้นด้วย postgres://...)
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# (ไม่บังคับ) รหัสลับป้องกันการเรียก API — ถ้าตั้งค่า frontend ต้องส่งค่าเดียวกันใน VITE_API_TOKEN
API_TOKEN=

# (ไม่บังคับ) แยกชุดข้อมูลหลายโรงเรียน/หลายปี ด้วย id คนละค่า
WORKSPACE_ID=default

# พอร์ต (Render กำหนดให้เอง ไม่ต้องตั้งบน Render)
PORT=3001
