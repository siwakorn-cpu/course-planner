# คัดลอกเป็น .env เพื่อเชื่อมฐานข้อมูลกลาง (ถ้าไม่ตั้งค่า แอปจะใช้ localStorage ในเครื่อง)
# บน Render (Static Site) ให้ตั้งค่าเหล่านี้ในหน้า Environment ของ service

# ลิงก์ Backend API (Render Web Service) — ไม่ต้องมี / ปิดท้าย
VITE_API_URL=https://course-planner-api.onrender.com

# (ไม่บังคับ) ต้องตรงกับ API_TOKEN ฝั่ง backend — หมายเหตุ: ค่านี้ฝังอยู่ในไฟล์เว็บ ถือเป็นการป้องกันแบบเบา ๆ
VITE_API_TOKEN=
